# .streamlit/secrets.toml.example
# -----------------------------------------------------------
# DO NOT commit secrets.toml — it contains real API keys.
# Copy this file to .streamlit/secrets.toml for local use,
# OR paste these keys into Streamlit Cloud → App Settings → Secrets.
# -----------------------------------------------------------

GROQ_API_KEY       = "gsk_your_groq_key_here"
GROQ_MODEL         = "qwen/qwen3.8-27b"

GEMINI_FLASH_API_KEY = "your_gemini_key_here"
FLASH_MODEL          = "gemini-2.5-flash"
